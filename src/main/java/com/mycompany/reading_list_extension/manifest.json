{
  "manifest_version": 3,
  "name": "Capture Page URL",
  "version": "1.0",
  "description": "Capture the page's URL & send to localhost.",
  "permissions": ["activeTab", "tabs"],
    "host_permissions": [
        "http://localhost:8080/*",
        "<all_urls>"
    ],
  "action": {
    "default_popup": "index.html"
  }
}
